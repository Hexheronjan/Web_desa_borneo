  updatedAt   DateTime @updatedAt
}

model InformasiAdat {
  id          String   @id @default(cuid())
  judul       String
  kategori    String
  konten      String   @db.Text
  gambar      String?
  penulis     String?
  tanggal     DateTime
  status      String   @default("Publik")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model KalenderAdat {
  id          String   @id @default(cuid())
  desaId      String
  namaAcara   String
  tanggal     DateTime
