generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "debian-openssl-1.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x", "rhel-openssl-1.0.x", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  username  String   @unique
  password  String
  role      Role
  status    String   @default("Aktif")
  desaId    String
  wargaId   String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  desa      Desa     @relation(fields: [desaId], references: [id])
  warga     Warga?   @relation(fields: [wargaId], references: [id])

  @@index([desaId], map: "User_desaId_fkey")
}

model Desa {
  id          String   @id @default(cuid())
  nama        String
  kecamatan   String
  kabupaten   String
  provinsi    String
  luasWilayah Float?
  sejarah     String?  @db.Text
  createdAt   DateTime @default(now())
  rwrts       RwRt[]
  users       User[]
  warga       Warga[]
}

model RwRt {
  id          String  @id @default(cuid())
  desaId      String
  rw          String
  rt          String
  jumlahWarga Int     @default(0)
  desa        Desa    @relation(fields: [desaId], references: [id])
  warga       Warga[]

  @@index([desaId], map: "RwRt_desaId_fkey")
}

model Warga {
  id           String                @id @default(cuid())
  desaId       String
  rwRtId       String
  nik          String                @unique
  nama         String
  tempatLahir  String
  tanggalLahir DateTime
  jenisKelamin JenisKelamin
  alamat       String                @db.Text
  noHp         String?
  foto         String?
  status       StatusWarga           @default(Baru)
  createdAt    DateTime              @default(now())
  aspirasi     Aspirasi[]
  monitoring   MonitoringKesehatan[]
  pesertaKelas PesertaKelas[]
  rekamMedis   RekamMedis[]
  stunting     Stunting[]
  telemedicine Telemedicine[]
  user         User?
  desa         Desa                  @relation(fields: [desaId], references: [id])
  rwRt         RwRt                  @relation(fields: [rwRtId], references: [id])

  @@index([desaId], map: "Warga_desaId_fkey")
  @@index([rwRtId], map: "Warga_rwRtId_fkey")
}

model Kelas {
  id            String         @id @default(cuid())
  desaId        String
  modul         ModulBelajar
  nama          String
  batch         String
  waktu         String
  fasilitatorId String?
  status        StatusKelas    @default(Aktif)
  createdAt     DateTime       @default(now())
  forum         Forum[]
  materi        Materi[]
  peserta       PesertaKelas[]
  tugas         Tugas[]
}

model Materi {
  id        String     @id @default(cuid())
  kelasId   String
  judul     String
  tipe      TipeMateri
  url       String
  createdAt DateTime   @default(now())
  kelas     Kelas      @relation(fields: [kelasId], references: [id])

  @@index([kelasId], map: "Materi_kelasId_fkey")
}

model PesertaKelas {
  id         String      @id @default(cuid())
  kelasId    String
  wargaId    String
  status     StatusWarga @default(Baru)
  nilai      Float?
  sertifikat String?
  createdAt  DateTime    @default(now())
  kelas      Kelas       @relation(fields: [kelasId], references: [id])
  warga      Warga       @relation(fields: [wargaId], references: [id])

  @@index([kelasId], map: "PesertaKelas_kelasId_fkey")
  @@index([wargaId], map: "PesertaKelas_wargaId_fkey")
}

model Tugas {
  id           String   @id @default(cuid())
  kelasId      String
  judul        String
  deskripsi    String   @db.Text
  deadline     DateTime
  statusReview String   @default("pending")
  createdAt    DateTime @default(now())
  kelas        Kelas    @relation(fields: [kelasId], references: [id])

  @@index([kelasId], map: "Tugas_kelasId_fkey")
}

model RekamMedis {
  id        String   @id @default(cuid())
  wargaId   String
  tanggal   DateTime
  diagnosis String
  nakes     String
  catatan   String?  @db.Text
  alergi    String?
  createdAt DateTime @default(now())
  warga     Warga    @relation(fields: [wargaId], references: [id])

  @@index([wargaId], map: "RekamMedis_wargaId_fkey")
}

model Telemedicine {
  id                String             @id @default(cuid())
  wargaId           String
  waktu             DateTime
  status            StatusTelemedicine @default(Antrian)
  nakesId           String?
  catatanKonsultasi String?            @db.Text
  suratRujukan      String?
  createdAt         DateTime           @default(now())
  warga             Warga              @relation(fields: [wargaId], references: [id])

  @@index([wargaId], map: "Telemedicine_wargaId_fkey")
}

model MonitoringKesehatan {
  id             String   @id @default(cuid())
  wargaId        String
  tanggal        DateTime
  beratBadan     Float?
  tinggiBadan    Float?
  tensiSistolik  Int?
  tensiDiastolik Int?
  suhu           Float?
  alert          Boolean  @default(false)
  createdAt      DateTime @default(now())
  warga          Warga    @relation(fields: [wargaId], references: [id])

  @@index([wargaId], map: "MonitoringKesehatan_wargaId_fkey")
}

model Posyandu {
  id              String   @id @default(cuid())
  desaId          String
  tanggal         DateTime
  lokasi          String
  jumlahBalita    Int      @default(0)
  jumlahImunisasi Int      @default(0)
  catatan         String?  @db.Text
  createdAt       DateTime @default(now())
}

model Stunting {
  id          String           @id @default(cuid())
  wargaId     String
  tanggal     DateTime
  bb          Float
  tb          Float
  umurBulan   Int
  zScore      Float
  kategori    KategoriStunting @default(Normal)
  rekomendasi String?          @db.Text
  createdAt   DateTime         @default(now())
  warga       Warga            @relation(fields: [wargaId], references: [id])

  @@index([wargaId], map: "Stunting_wargaId_fkey")
}

model Pengurus {
  id        String   @id @default(cuid())
  desaId    String
  nama      String
  jabatan   String
  bidang    String
  periode   String
  dokumen   String?
  status    String   @default("Aktif")
  createdAt DateTime @default(now())
}

model ArsipAdat {
  id           String    @id @default(cuid())
  desaId       String
  judul        String
  kategori     String
  tipe         TipeArsip
  url          String
  tahun        Int?
  narasumber   String?
  lokasi       String?
  statusReview String    @default("Review")
  createdAt    DateTime  @default(now())
}

model Musyawarah {
  id         String   @id @default(cuid())
  desaId     String
  judul      String
  tanggal    DateTime
  keputusan  String?  @db.Text
  risalahUrl String?
  statusSah  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model WilayahAdat {
  id        String   @id @default(cuid())
  desaId    String
  namaLayer String
  koordinat Json
  validasi  Boolean  @default(false)
  sengketa  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model HukumAdat {
  id            String        @id @default(cuid())
  desaId        String
  judul         String
  tipe          TipeHukumAdat
  deskripsi     String        @db.Text
  status        String        @default("Aktif")
  tanggalSidang DateTime?
  putusan       String?       @db.Text
  publik        Boolean       @default(false)
  createdAt     DateTime      @default(now())
}

model AuditTrail {
  id        String   @id @default(cuid())
  userId    String
  modul     String
  aksi      String
  detail    String?  @db.Text
  createdAt DateTime @default(now())
}

model Notifikasi {
  id          String   @id @default(cuid())
  userId      String
  judul       String
  pesan       String   @db.Text
  tipe        String
  sudahDibaca Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Laporan {
  id        String   @id @default(cuid())
  desaId    String
  modul     String
  periode   String
  fileUrl   String?
  createdAt DateTime @default(now())
}

// === CLASS DIAGRAM UML: STRUKTUR KESIAPAN (RQ1) ===

/// Dimensi penilaian kesiapan (SDM, Infrastruktur, Tata Kelola, dll)
model Dimensi {
  id              String      @id @default(cuid())
  frameworkId     String
  nama            String
  deskripsi       String?     @db.Text
  bobot           Float       @default(1.0)
  urutan          Int         @default(0)
  status          String      @default("Aktif")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  indikator       Indikator[]
}

/// Indikator penilaian per dimensi
model Indikator {
  id            String          @id @default(cuid())
  dimensiId     String
  nama          String
  deskripsi     String?         @db.Text
  satuan        String?
  targetNilai   Float?
  bobot         Float           @default(1.0)
  tipe          String          @default("Kuantitatif")
  status        String          @default("Aktif")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  dimensi       Dimensi         @relation(fields: [dimensiId], references: [id])
  nilaiIndikator NilaiIndikator[]

  @@index([dimensiId], map: "Indikator_dimensiId_fkey")
}

/// Nilai aktual indikator per desa per periode penilaian
model NilaiIndikator {
  id          String      @id @default(cuid())
  indikatorId String
  desaId      String
  periode     String
  nilai       Float
  sumber      String?
  catatan     String?     @db.Text
  status      String      @default("Draft")
  createdBy   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  indikator   Indikator   @relation(fields: [indikatorId], references: [id])
  buktiData   BuktiData[]

  @@index([indikatorId], map: "NilaiIndikator_indikatorId_fkey")
  @@index([desaId])
}

/// Bukti pendukung untuk nilai indikator (dokumen, foto, dll)
model BuktiData {
  id               String         @id @default(cuid())
  nilaiIndikatorId String
  judul            String
  tipe             String         @default("dokumen")
  fileUrl          String
  keterangan       String?        @db.Text
  uploadedBy       String?
  statusReview     String         @default("Menunggu")
  reviewedBy       String?
  reviewedAt       DateTime?
  createdAt        DateTime       @default(now())
  nilaiIndikator   NilaiIndikator @relation(fields: [nilaiIndikatorId], references: [id])

  @@index([nilaiIndikatorId], map: "BuktiData_nilaiIndikatorId_fkey")
}

// === CLASS DIAGRAM UML: MUSYAWARAH DAN PROGRAM ===

/// Program desa resmi yang telah diputuskan
model ProgramDesa {
  id              String    @id @default(cuid())
  desaId          String
  namaProgram     String
  deskripsi       String?   @db.Text
  bidang          String
  anggaranTotal   Float?
  sumberDana      String?
  periode         String
  statusProgram   String    @default("Diusulkan")
  prioritas       Int       @default(0)
  penanggungJawab String?
  targetCapaian   String?   @db.Text
  tanggalMulai    DateTime?
  tanggalSelesai  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  keputusan       KeputusanProgram[]
}

/// Keputusan resmi dari musyawarah yang menetapkan program
model KeputusanProgram {
  id            String      @id @default(cuid())
  desaId        String
  musyawarahId  String?
  programDesaId String?
  nomorKeputusan String?
  judulKeputusan String
  isiKeputusan  String      @db.Text
  tanggalKeputusan DateTime
  statusSah     Boolean     @default(false)
  disetujuiOleh String?
  catatan       String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  programDesa   ProgramDesa? @relation(fields: [programDesaId], references: [id])

  @@index([programDesaId], map: "KeputusanProgram_programDesaId_fkey")
}

// === CLASS DIAGRAM UML: IDENTITAS DAN AKSES ===

/// Persetujuan dan manajemen hak akses pengguna ke modul/fitur tertentu
model PersetujuanAkses {
  id          String   @id @default(cuid())
  userId      String
  modul       String
  aksesLevel  String   @default("Baca")
  disetujuiOleh String?
  alasan      String?  @db.Text
  status      String   @default("Aktif")
  berlakuHingga DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Forum {
  id        String    @id @default(cuid())
  kelasId   String
  judul     String
  createdAt DateTime  @default(now())
  diskusi   Diskusi[]
  kelas     Kelas     @relation(fields: [kelasId], references: [id])

  @@index([kelasId], map: "Forum_kelasId_fkey")
}

model Diskusi {
  id        String   @id @default(cuid())
  forumId   String
  userId    String
  pesan     String   @db.Text
  createdAt DateTime @default(now())
  forum     Forum    @relation(fields: [forumId], references: [id])

  @@index([forumId], map: "Diskusi_forumId_fkey")
}

model ShiftNakes {
  id         String   @id @default(cuid())
  desaId     String
  namaNakes  String
  hari       String
  jamMulai   String
  jamSelesai String
  status     String   @default("Aktif")
  createdAt  DateTime @default(now())
}

model Aspirasi {
  id        String   @id @default(cuid())
  desaId    String
  wargaId   String?
  kategori  String
  judul     String
  isi       String   @db.Text
  status    String   @default("Diterima")
  createdAt DateTime @default(now())
  warga     Warga?   @relation(fields: [wargaId], references: [id])

  @@index([wargaId], map: "Aspirasi_wargaId_fkey")
}

model Siswa {
  id        String   @id @default(cuid())
  desaId    String
  nisn      String   @unique
  nama      String
  kelas     String
  jenjang   String
  status    String   @default("Aktif")
  createdAt DateTime @default(now())
}

model MonitoringDesa {
  id        String   @id @default(cuid())
  namaDesa  String
  kecamatan String
  index     Float
  readiness Float
  maturity  Float
  status    String
  createdAt DateTime @default(now())
}

model MasterDesaRecord {
  id        String   @id @default(cuid())
  kodeDesa  String   @unique
  nama      String
  kecamatan String
  kabupaten String
  provinsi  String
  status    String   @default("Berkembang")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ModuleRecord {
  id          String   @id @default(cuid())
  modulePath  String
  moduleName  String
  title       String
  category    String?
  description String?  @db.Text
  valueText   String?  @db.Text
  valueBlob   String?  @db.LongText
  status      String   @default("Baru")
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([modulePath, createdAt])
}

model Umkm {
  id        String   @id @default(cuid())
  desaId    String
  nama      String
  pemilik   String
  bidang    String
  omset     Float?
  status    String   @default("Aktif")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MasterFramework {
  id            String   @id @default(cuid())
  namaFramework String
  dimensi       String   @db.Text
  indikator     String   @db.Text
  bobot         String
  status        String   @default("Aktif")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model FrameworkVersioning {
  id        String   @id @default(cuid())
  versi     String
  tanggal   DateTime
  status    String   @default("Non-Aktif")
  createdAt DateTime @default(now())
}

model ManajemenPeriode {
  id        String   @id @default(cuid())
  tahun     String
  semester  String
  status    String   @default("Tutup")
  createdAt DateTime @default(now())
}

model ValidasiData {
  id             String   @id @default(cuid())
  namaDataset    String
  jumlahData     Int
  statusValidasi String
  tanggalUpload  DateTime
  createdAt      DateTime @default(now())
}

model IntegrasiDataDesa {
  id                   String   @id @default(cuid())
  namaSumber           String
  tipe                 String
  apiEndpoint          String?
  status               String   @default("Tidak Terhubung")
  terakhirSinkronisasi String
  createdAt            DateTime @default(now())
}

model GovernanceManagement {
  id             String   @id @default(cuid())
  namaGovernance String
  kategori       String
  deskripsi      String   @db.Text
  status         String   @default("Aktif")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model DSSKnowledgeBase {
  id        String   @id @default(cuid())
  namaRule  String
  kategori  String
  bobot     Float
  aturan    String   @db.Text
  status    String   @default("Aktif")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EvaluasiArtefak {
  id              String   @id @default(cuid())
  namaArtefak     String
  jenis           String
  nilaiEvaluasi   Float
  kategori        String
  tanggalEvaluasi DateTime
  createdAt       DateTime @default(now())
}

model ExpertValidation {
  id                String   @id @default(cuid())
  namaValidator     String
  keahlian          String
  artefakDivalidasi String   @db.Text
  nilaiValiditas    Float
  status            String   @default("Pending")
  createdAt         DateTime @default(now())
}

model UATResult {
  id        String   @id @default(cuid())
  namaUser  String
  role      String
  susScore  Float
  kategori  String
  feedback  String   @db.Text
  tanggal   DateTime
  createdAt DateTime @default(now())
}

model ResearchRepository {
  id            String   @id @default(cuid())
  judul         String
  jenis         String
  penulis       String
  tahun         String
  ukuran        String
  tanggalUpload DateTime
  createdAt     DateTime @default(now())
}

model KonfigurasiSistem {
  id              String   @id @default(cuid())
  namaSistem      String   @default("APL-SLV BORNEO Smart Living Village")
  versiSistem     String   @default("v2.0")
  urlSistem       String
  emailAdmin      String
  deskripsiSistem String   @db.Text
  maxUploadSize   String   @default("50")
  sessionTimeout  String   @default("60")
  maintenanceMode Boolean  @default(false)
  backupOtomatis  Boolean  @default(true)
  backupSchedule  String   @default("02:00")
  notifikasiEmail Boolean  @default(true)
  notifikasiSms   Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PengaturanNotifikasi {
  id           String   @id @default(cuid())
  judul        String
  isi          String   @db.Text
  target       String
  tanggalKirim DateTime
  status       String   @default("Terkirim")
  createdAt    DateTime @default(now())
}

