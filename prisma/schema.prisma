model RiwayatPelatihan {
  id          String   @id @default(cuid())
  wargaId     String
  pelatihanId String
  tanggalMulai DateTime
  tanggalSelesai DateTime?
  progress    Float    @default(0)
  status      String   @default("Berjalan")
